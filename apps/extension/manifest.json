{
  "manifest_version": 3,
  "name": "CampusSchedule Importer",
  "version": "0.1.0",
  "description": "在已登录的学校教务系统页面中解析个人课表并导出为 CampusSchedule JSON。不保存学校账号、密码、验证码或 Cookie。",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": ["https://*.gdipu.edu.cn/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.gdipu.edu.cn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CampusSchedule Importer",
    "default_popup": "popup.html"
  }
}
